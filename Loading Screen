local function setProgress(value, message)
    value = math.clamp(value, 0, 100)
    status.Text = message
    percent.Text = tostring(math.floor(value)) .. "%"
    TweenService:Create(bar, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromScale(value / 100, 1)
    }):Play()
end

local function finish(message, hasError)
    title.Text = hasError and "CÓ LỖI" or "HOÀN TẤT"
    status.Text = message
    percent.Text = hasError and "!" or "100%"
    bar.BackgroundColor3 = hasError and C.red or C.green
    bar.Size = UDim2.fromScale(1, 1)
    task.wait(2)
    if gui then gui:Destroy() end
end

----------------------------------------------------------------
-- DỌN FILE / THƯ MỤC THỪA
----------------------------------------------------------------
local function readSafe(path)
    local ok, content = pcall(readfile, path)
    if ok and type(content) == "string" then return content end
    return nil
end

-- Xóa file nếu nội dung đúng là nội dung mẫu. Trả về true nếu đã xóa.
local function dropIfPlaceholder(path, expected)
    if not isfile(path) then return false end
    if readSafe(path) ~= expected then return false end
    return pcall(delfile, path)
end

local function cleanupUnused()
    if typeof(delfile) ~= "function" then return 0 end
    local removed = 0

    if dropIfPlaceholder(ROOT_FOLDER .. "/Slot1.txt", "This is Slot1 file") then removed += 1 end
    if dropIfPlaceholder(ROOT_FOLDER .. "/Data.txt", "") then removed += 1 end

    if isfolder(OLD_DATA_FOLDER) then
        for i = 1, OLD_SLOT_COUNT do
            if dropIfPlaceholder(OLD_DATA_FOLDER .. "/Slot" .. i .. ".txt", "This is Slot" .. i) then
                removed += 1
            end
        end
        -- Chỉ xóa thư mục Data khi đã trống (không còn file nào của bạn)
        local okList, left = pcall(listfiles, OLD_DATA_FOLDER)
        if okList and type(left) == "table" and #left == 0 and typeof(delfolder) == "function" then
            if pcall(delfolder, OLD_DATA_FOLDER) then removed += 1 end
        end
    end
    return removed
end

local ok, err = pcall(function()
    setProgress(15, "Đang kiểm tra thư mục...")
    if not isfolder(ROOT_FOLDER) then makefolder(ROOT_FOLDER) end

    setProgress(35, "Đang dọn file thừa...")
    local removed = cleanupUnused()

    setProgress(60, "Đang kiểm tra URL script...")
    if not SCRIPT_URL or SCRIPT_URL == "" or SCRIPT_URL == "LINK" then
        error('Bạn chưa đặt URL raw của script trong SCRIPT_URL.')
    end

    setProgress(75, "Đang tải script...")
    local source = game:HttpGet(SCRIPT_URL)
    if type(source) ~= "string" or source == "" then
        error("Không tải được mã nguồn từ URL.")
    end

    setProgress(90, "Đang chạy script...")
    local chunk, compileError = loadstring(source)
    if not chunk then
        error("Lỗi biên dịch script: " .. tostring(compileError))
    end
    chunk()
    setProgress(100, removed > 0 and ("Đã dọn " .. removed .. " mục thừa và chạy script.") or "Đã chạy script.")
end)

if ok then
    finish("Đã tải xong, script đang chạy.", false)
else
    warn("[Loading] " .. tostring(err))
    finish(tostring(err), true)
end
