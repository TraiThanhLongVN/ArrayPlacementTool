-- Chuyển Array thành văn bản (định dạng của Array Panel)
local function entryText(i, it)
    local c = cfStrings(it.CF)
    return string.format(
        '    -- Vị trí array %d\n    { PathBlock = %q,\n      Vector = CFrame.new(%s, %s, %s, %s,%s,%s, %s,%s,%s, %s,%s,%s),\n      Resize = Vector3.new(%s, %s, %s),\n    },',
        i, it.PathBlock or "",
        c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12],
        fmtNum(it.Resize.X), fmtNum(it.Resize.Y), fmtNum(it.Resize.Z)
    )
end

buildText = function()
    local lines = { "local BlockArray = {" }
    for i, it in ipairs(BlockArray) do
        lines[#lines + 1] = entryText(i, it)
        if i < #BlockArray then
            lines[#lines + 1] = ""
        end
    end
    lines[#lines + 1] = "}"
    return table.concat(lines, "\n")
end

-- Đọc văn bản Array Panel -> danh sách phần tử mới
local function parseArrayText(src)
    src = (src:gsub("%-%-[^\n]*", "")) -- bỏ chú thích
    local outer = src:match("%b{}")
    if not outer then
        return nil, "Không tìm thấy bảng { ... }"
    end
    local blocks = {}
    for b in outer:sub(2, -2):gmatch("%b{}") do
        blocks[#blocks + 1] = b
    end
    if #blocks == 0 then
        blocks[1] = outer -- người dùng dán đúng 1 phần tử
    end

    local items = {}
    for i, b in ipairs(blocks) do
        local path = b:match('PathBlock%s*=%s*"(.-)"') or b:match("PathBlock%s*=%s*'(.-)'")
        if not path then
            return nil, string.format("Vị trí %d: thiếu PathBlock", i)
        end
        local vecArgs = b:match("Vector%s*=%s*[%w%.]+%s*(%b())")
        if not vecArgs then
            return nil, string.format("Vị trí %d: thiếu Vector", i)
        end
        local resArgs = b:match("Resize%s*=%s*[%w%.]+%s*(%b())")
        if not resArgs then
            return nil, string.format("Vị trí %d: thiếu Resize", i)
        end
        local cf, e1 = parseCFrame(vecArgs)
        if not cf then
            return nil, string.format("Vị trí %d: Vector - %s", i, e1)
        end
        local sz, e2 = parseSize(resArgs)
        if not sz then
            return nil, string.format("Vị trí %d: Resize - %s", i, e2)
        end
        local it = newItem(trim(path))
        it.CF = cf
        it.Resize = sz
        items[#items + 1] = it
    end
    return items
end

