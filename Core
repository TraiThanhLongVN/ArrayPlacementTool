local fileMode = "import"
local function cleanFileName(name)
    name = tostring(name or ""):gsub("[/\\\\]", ""):gsub("%.%.", "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    if not name:match("%.[Tt][Xx][Tt]$") then name = name .. ".txt" end
    return name
end
local function refreshFileList()
    for _, child in ipairs(fileList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    local ok, files = pcall(function() return listfiles(ROOT_FOLDER) end)
    if ok and type(files) == "table" then
        for _, path in ipairs(files) do
            local name = tostring(path):match("([^/\\\\]+)$") or tostring(path)
            if name:lower():match("%.txt$") then names[#names + 1] = name end
        end
    end
    table.sort(names, function(a,b) return a:lower() < b:lower() end)
    if #names == 0 then
        local empty = mk("TextLabel", {Size = UDim2.new(1, -4, 0, 28), BackgroundTransparency = 1,
            Text = "Chưa có file .txt trong folder", TextColor3 = C.text, Font = Enum.Font.Arial, TextSize = 13}, fileList)
    end
    for i, name in ipairs(names) do
        local b = mk("TextButton", {LayoutOrder = i, Size = UDim2.new(1, -4, 0, 28),
            BackgroundColor3 = C.row, BorderSizePixel = 0, Text = "  " .. name,
            TextColor3 = C.text, Font = Enum.Font.Arial, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left}, fileList)
        mk("UICorner", {CornerRadius = UDim.new(0, 4)}, b)
        b.Activated:Connect(function()
            fileNameBox.Text = name
            if fileMode == "import" then
                local okRead, content = pcall(function() return readfile(ROOT_FOLDER .. "/" .. name) end)
                if not okRead then notify("Không đọc được file: " .. name, C.red) return end
                local items, err = parseArrayText(content)
                if not items then notify("Import lỗi: " .. tostring(err), C.red) return end
                BlockArray = items
                selected = items[1]
                holding = nil
                dirty = false
                loadBoxes()
                refreshAll()
                setEditorText(buildText())
                notify("Đã Import " .. name .. " (" .. #items .. " phần tử).", C.green)
                toggleWin(fileWin)
            end
        end)
    end
end
local fileActionBtn = mk("TextButton", {Position = UDim2.new(0, 8, 1, -34), Size = UDim2.new(1, -16, 0, 28),
    BackgroundColor3 = C.peri, BorderSizePixel = 0, TextColor3 = C.ink, Font = Enum.Font.ArialBold,
    TextSize = 14, Text = "Export Array"}, fileWin.body)
