local function ensureVisible()
    task.delay(0.05, function()
        local i = indexOf(selected)
        if not i then return end
        local top = (i - 1) * (ROW_H + ROW_GAP)
        local bottom = top + ROW_H
        local pos = listFrame.CanvasPosition.Y
        local view = listFrame.AbsoluteSize.Y
        if top < pos then
            listFrame.CanvasPosition = Vector2.new(0, top)
        elseif bottom > pos + view then
            listFrame.CanvasPosition = Vector2.new(0, bottom - view + ROW_GAP)
        end
    end)
