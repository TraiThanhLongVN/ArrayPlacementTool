-- Theo dõi một thao tác kéo (chuột hoặc cảm ứng). onMove nhận độ lệch so với lúc bắt đầu.
local function dragSession(began, onMove, onEnd)
    local isMouse = began.UserInputType == Enum.UserInputType.MouseButton1
    local startPos = began.Position
    local moveConn, endConn
    local function finish()
        if moveConn then moveConn:Disconnect() moveConn = nil end
        if endConn then endConn:Disconnect() endConn = nil end
        if onEnd then onEnd() end
    end
    moveConn = UserInputService.InputChanged:Connect(function(input)
        if (isMouse and input.UserInputType == Enum.UserInputType.MouseMovement)
            or (not isMouse and input.UserInputType == Enum.UserInputType.Touch) then
            onMove(input.Position - startPos)
        end
    end)
    endConn = began.Changed:Connect(function()
        if began.UserInputState == Enum.UserInputState.End then
            finish()
        end
    end)
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local zTop = 1
local function bringToFront(frame)
    zTop = zTop + 1
    frame.ZIndex = zTop
end

local function makeDraggable(handle, frame)
    handle.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        bringToFront(frame)
        local startPos = frame.Position
        dragSession(input, function(d)
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end)
    end)
end

local function makeResizable(handle, frame, minW, minH)
    handle.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        bringToFront(frame)
        local startSize = frame.AbsoluteSize
        dragSession(input, function(d)
            frame.Size = UDim2.new(
                0, math.max(minW, startSize.X + d.X),
                0, math.max(minH, startSize.Y + d.Y)
            )
        end)
    end)
end

-- Tạo cửa sổ có thanh tiêu đề, nút — (ẩn bớt), X (ẩn GUI) và ◢ (đổi kích thước)
local function makeWindow(name, title, pos, size, minW, minH, titleBg, titleFg)
    local frame = mk("Frame", {
        Name = name, Position = pos, Size = size,
        BackgroundColor3 = C.navy, BorderSizePixel = 0,
    }, gui)
    mk("UICorner", { CornerRadius = UDim.new(0, 6) }, frame)
    mk("UIStroke", { Color = C.peri, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, frame)

    local bar = mk("Frame", {
        Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H),
        BackgroundColor3 = titleBg, BorderSizePixel = 0,
    }, frame)
    mk("UICorner", { CornerRadius = UDim.new(0, 6) }, bar)
    mk("Frame", {
        Position = UDim2.new(0, 0, 1, -8), Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = titleBg, BorderSizePixel = 0,
    }, bar)
    mk("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(1, -70, 1, 0), Text = title, Font = Enum.Font.Arial,
        TextSize = 20, TextColor3 = titleFg, TextXAlignment = Enum.TextXAlignment.Left,
    }, bar)

    local function barBtn(text, x)
        return mk("TextButton", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, x, 0, 0), Size = UDim2.new(0, 30, 1, 0),
            Text = text, Font = Enum.Font.ArialBold, TextSize = 22, TextColor3 = titleFg,
        }, bar)
    end
    local minBtn = barBtn("—", -34)
    local closeBtn = barBtn("X", -4)

    local body = mk("Frame", {
        Name = "Body", BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, TITLE_H), Size = UDim2.new(1, 0, 1, -TITLE_H),
        ClipsDescendants = true,
    }, frame)

    local handle = mk("TextButton", {
        Name = "ResizeHandle", AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -1, 1, -1), Size = UDim2.new(0, 22, 0, 22),
        BackgroundTransparency = 1, Text = "◢", Font = Enum.Font.Arial, TextSize = 20,
        TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom, ZIndex = 20,
    }, frame)

    makeDraggable(bar, frame)
    makeResizable(handle, frame, minW, minH)

    local minimized, savedSize = false, nil
    minBtn.Activated:Connect(function()
        minimized = not minimized
        if minimized then
            savedSize = frame.Size
            body.Visible = false
            handle.Visible = false
            frame.Size = UDim2.new(savedSize.X.Scale, savedSize.X.Offset, 0, TITLE_H)
        else
            frame.Size = savedSize
            body.Visible = true
            handle.Visible = true
        end
    end)
    closeBtn.Activated:Connect(function()
        frame.Visible = false
    end)

    return { frame = frame, body = body }
end

