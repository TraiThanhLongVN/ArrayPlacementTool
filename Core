        refreshAll()
        dragSession(input, function(d)
            local target = startIdx + math.floor(d.Y / (ROW_H + ROW_GAP) + 0.5)
            target = math.clamp(target, 1, #BlockArray)
            local cur = indexOf(it)
            if cur and target ~= cur then
                table.remove(BlockArray, cur)
                table.insert(BlockArray, target, it)
                refreshAll()
            end
        end, function()
            holding = nil
            listFrame.ScrollingEnabled = true
            refreshAll()
        end)
    end)

    rowCache[it] = r
    return r
end

local function refreshList()
    local present = {}
    for _, it in ipairs(BlockArray) do
        present[it] = true
    end
    for it, r in pairs(rowCache) do
        if not present[it] then
            r.frame:Destroy()
            rowCache[it] = nil
        end
    end

    local query = string.lower(trim(searchBox and searchBox.Text or ""))
    local visibleOrder = 0
    for i, it in ipairs(BlockArray) do
        local r = rowCache[it] or createRow(it)
        local vecText = textCFFull(it.CF)
        local sizeText = textVec(it.Resize)
        local matches = query == "" or string.find(string.lower(vecText), query, 1, true)
            or string.find(string.lower(sizeText), query, 1, true)
            or string.find(string.lower("block " .. i), query, 1, true)
        r.frame.Visible = not not matches
        if matches then
            visibleOrder += 1
            r.frame.LayoutOrder = visibleOrder
        else
            r.frame.LayoutOrder = i + #BlockArray
        end
        r.frame.BackgroundColor3 = (it == selected) and C.rowSel or C.row
        r.idx.Text = tostring(i)
        r.title.Text = "Block #" .. i
        r.vec.Text = vecText
        r.size.Text = "Size " .. sizeText
        r.status.Text = (it == selected) and "⬢" or "⬡"
        r.status.TextColor3 = (it == selected) and C.yellow or statusColor(it.Status)
        r.hold.BackgroundColor3 = (it == holding) and C.peri or C.dark
        r.hold.TextColor3 = (it == holding) and C.ink or C.text
    end

    countLabel.Text = "(" .. #BlockArray .. ")"
    local si = indexOf(selected) or 1
    backBtn.BackgroundTransparency = (si <= 1) and 0.6 or 0
    nextBtn.BackgroundTransparency = (si >= #BlockArray) and 0.6 or 0
end

