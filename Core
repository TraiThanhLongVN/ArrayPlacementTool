-- Đặt nhiều Block cùng lúc. Mỗi job nhận lại đúng Block của mình:
-- ưu tiên Instance server trả về; nếu không có thì ghép với Block mới có ColorPart gần PlaceCF nhất.
local function placeBatch(batch)
    local remote, rerr = getRemote("PlaceBlock")
    local container, cerr = getContainer()
    if not remote or not container then
        for _, job in ipairs(batch) do
            job.Err = rerr or cerr
        end
        return
    end

    local existing = {}
    for _, c in ipairs(container:GetChildren()) do
        existing[c] = true
    end
    local newChildren = {}
    local conn = container.ChildAdded:Connect(function(child)
        if not existing[child] then
            newChildren[#newChildren + 1] = child
        end
    end)

    local pending = #batch
    for _, job in ipairs(batch) do
        task.spawn(function()
            local ok, ret = pcall(function()
                return remote:InvokeServer(
                    job.Template, job.PlaceCF,
                    BrickColor.new(CONFIG.BlockColor), CONFIG.BlockMaterial
                )
            end)
            if not ok then
                job.Err = "PlaceBlock lỗi: " .. tostring(ret)
            elseif ret == false then
                job.Err = "Server từ chối PlaceBlock"
            elseif typeof(ret) == "Instance" and ret.Parent then
                job.Returned = ret
            end
            pending -= 1
        end)
    end

    local waited = 0
    while pending > 0 and waited < CONFIG.PlaceWaitTimeout do
        task.wait(0.05)
        waited += 0.05
    end
    task.wait(CONFIG.SettleTime)
    conn:Disconnect()

    local used = {}
    for _, job in ipairs(batch) do
        if not job.Err then
            local block = job.Returned
            if not (block and block.Parent) then
                local best, bestDist = nil, math.huge
                for _, child in ipairs(newChildren) do
                    if child.Parent and not used[child] then
                        local cp = findColorPart(child)
                        if cp then
                            local d = (cp.Position - job.PlaceCF.Position).Magnitude
                            if d < bestDist then
                                best, bestDist = child, d
                            end
                        end
                    end
                end
                block = best
            end

            if block and block.Parent then
                used[block] = true
                job.Block = block
                job.ColorPart = findColorPart(block)
                local w = 0
                while not job.ColorPart and w < CONFIG.ColorPartTimeout do
                    task.wait(0.1)
                    w += 0.1
                    job.ColorPart = findColorPart(block)
                end
                if not job.ColorPart then
                    job.Err = "Block '" .. block.Name .. "' không có ColorPart/Part"
                end
            else
                job.Err = "Không xác định được Block vừa đặt (kiểm tra BuildContainer)"
            end
        end
    end
end

execBtn.Activated:Connect(function()
    if isRunning then return end -- chặn chạy chồng lên nhau
    saveFromBoxes(true)
    refreshAll()

    local templates, verr = validateAll()
    if not templates then
        notify("Lỗi kiểm tra: " .. verr, C.red)
        return
    end

    setLocked(true)
    for _, it in ipairs(BlockArray) do
        it.Status = nil
    end
    refreshList()

    task.spawn(function()
        local total = #BlockArray
        local success, failed = 0, 0
        local errors = {}

        -- Chụp dữ liệu để thay đổi UI trong lúc chạy không ảnh hưởng quy trình
        local snapshot = {}
        for i, it in ipairs(BlockArray) do
            snapshot[i] = { Item = it, CF = it.CF, Resize = it.Resize, Template = templates[i] }
        end

        -- Bước 1: tạo Block theo đợt. Block đầu tiên ở đích, các Block sau ở vị trí tạm xa nhau.
        assignStageCFrames(snapshot)
        for i, job in ipairs(snapshot) do
            job.Index = i
        end
        local placed = {}
        local stop = false
        for startIdx = 1, total, CONFIG.BatchSize do
            local batch = {}
            for i = startIdx, math.min(startIdx + CONFIG.BatchSize - 1, total) do
                batch[#batch + 1] = snapshot[i]
                snapshot[i].Item.Status = "run"
            end
            execBtn.Text = string.format("Đang đặt %d/%d", startIdx, total)
            refreshList()

            placeBatch(batch)

            for _, job in ipairs(batch) do
                if job.Err then
                    failed = failed + 1
                    job.Item.Status = "fail"
                    errors[#errors + 1] = string.format("#%d: %s", job.Index, tostring(job.Err))
                    warn("[BlockArrayTool] Vị trí " .. job.Index .. " lỗi khi Place: " .. tostring(job.Err))
                    if CONFIG.StopOnError then stop = true end
                else
                    placed[#placed + 1] = job
                end
            end
            refreshList()
            if stop then break end
            task.wait(CONFIG.StepDelay)
        end

        -- Bước 2: đưa Block về đích và đặt kích thước, theo đợt (các Block trong đợt chạy song song).
        for startIdx = 1, #placed, CONFIG.BatchSize do
            local batch = {}
            for i = startIdx, math.min(startIdx + CONFIG.BatchSize - 1, #placed) do
                batch[#batch + 1] = placed[i]
            end
            execBtn.Text = string.format("Đang hoàn tất %d/%d", startIdx, #placed)

            local pending = #batch
            for _, job in ipairs(batch) do
                task.spawn(function()
                    local stepOk, stepErr = moveBlock(job.Block, job.CF)
                    if stepOk then
                        stepOk, stepErr = resizeBlock(job.Block, job.ColorPart, job.CF, job.Resize)
                    end
                    job.StepOk, job.StepErr = stepOk, stepErr
                    pending -= 1
                end)
            end
            while pending > 0 do
                task.wait(0.05)
            end

            for _, job in ipairs(batch) do
                if job.StepOk then
                    success = success + 1
                    job.Item.Status = "ok"
                else
                    failed = failed + 1
                    job.Item.Status = "fail"
                    errors[#errors + 1] = string.format("#%d: %s", job.Index, tostring(job.StepErr))
                    warn("[BlockArrayTool] Vị trí " .. job.Index .. " lỗi khi hoàn tất: " .. tostring(job.StepErr))
                end
            end
            refreshList()
            task.wait(CONFIG.StepDelay)
        end

        setLocked(false)
        refreshAll()

        local msg = string.format("Xong: %d thành công, %d lỗi / %d.", success, failed, total)
        if #errors > 0 then
            msg = msg .. " " .. errors[1]
            if CONFIG.StopOnError then
                msg = msg .. " (đã dừng)"
            end
        end
        notify(msg, failed > 0 and C.yellow or C.green)
    end)
end)

