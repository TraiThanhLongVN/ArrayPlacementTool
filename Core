local lastDragPos = Vector2.new(0, 0)
local function updateDragRect(pos)
    lastDragPos = pos
    local x1, y1 = math.min(dragStart.X, pos.X), math.min(dragStart.Y, pos.Y)
    dragRect.Position = UDim2.fromOffset(x1, y1)
    dragRect.Size = UDim2.fromOffset(math.abs(pos.X - dragStart.X), math.abs(pos.Y - dragStart.Y))
    dragRect.Visible = true
end

-- Gom các BasePart được hỗ trợ trên Workspace; không thêm Model cha/container vào danh sách.
local function collectAllBlocks()
    local found = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and (d.Name == "Part" or d.Name == "ColorPart") then
            found[#found + 1] = d
        end
    end
    return found
end

local function getBlocksInRect(x1, y1, x2, y2)
    local out = {}
    local camera = workspace.CurrentCamera
    if not camera then return out end
    for _, block in ipairs(collectAllBlocks()) do
        local cf, size = blockInfo(block)
        if cf and size then
            local half = size / 2
            local bx1, by1, bx2, by2 = math.huge, math.huge, -math.huge, -math.huge
            local front = false
            for _, sx in ipairs({-1, 1}) do
                for _, sy in ipairs({-1, 1}) do
                    for _, sz in ipairs({-1, 1}) do
                        local point = camera:WorldToScreenPoint(cf * Vector3.new(sx * half.X, sy * half.Y, sz * half.Z))
                        if point.Z > 0 then
                            front = true
                            bx1, bx2 = math.min(bx1, point.X), math.max(bx2, point.X)
                            by1, by2 = math.min(by1, point.Y), math.max(by2, point.Y)
                        end
                    end
                end
            end
            if front then
                local overlapX = math.min(bx2, x2) - math.max(bx1, x1)
                local overlapY = math.min(by2, y2) - math.max(by1, y1)
                local center = camera:WorldToScreenPoint(cf.Position)
                local centerInside = center.Z > 0 and center.X >= x1 and center.X <= x2 and center.Y >= y1 and center.Y <= y2
                local area = math.max((bx2 - bx1) * (by2 - by1), 1)
                if centerInside or (overlapX > 0 and overlapY > 0 and overlapX * overlapY / area >= 0.35) then
                    out[#out + 1] = block
                end
            end
        end
    end
    return out
end

local function dragSelectAction(_, state, input)
    local pos = Vector2.new(input.Position.X, input.Position.Y)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if dragSelecting then updateDragRect(pos); return Enum.ContextActionResult.Sink end
        return Enum.ContextActionResult.Pass
    end
    if state == Enum.UserInputState.Begin then
        dragSelecting = true
        dragStart = pos
        local camera = workspace.CurrentCamera
        local ray = camera and camera:ScreenPointToRay(pos.X, pos.Y)
        local result = ray and workspace:Raycast(ray.Origin, ray.Direction * 2000)
        local firstBlock = result and findSelectablePart(result.Instance)
        dragAddMode = not (firstBlock and isBlockSelected(firstBlock))
        updateDragRect(pos)
    elseif state == Enum.UserInputState.Change then
        if dragSelecting then updateDragRect(pos) end
    else
        if dragSelecting then
            pos = lastDragPos
            dragSelecting = false
            dragRect.Visible = false
            local x1, y1 = math.min(dragStart.X, pos.X), math.min(dragStart.Y, pos.Y)
            local x2, y2 = math.max(dragStart.X, pos.X), math.max(dragStart.Y, pos.Y)
            local hits
            if x2 - x1 < 8 and y2 - y1 < 8 then
                local camera = workspace.CurrentCamera
                local ray = camera and camera:ScreenPointToRay(pos.X, pos.Y)
                local result = ray and workspace:Raycast(ray.Origin, ray.Direction * 2000)
                hits = result and {findSelectablePart(result.Instance)} or {}
            else
                hits = getBlocksInRect(x1, y1, x2, y2)
            end
            local before = #selectedBlocks
            for _, block in ipairs(hits) do
                if block then
                    if dragAddMode then
                        addBlockSelection(block)
                    else
                        removeBlockSelection(block)
                    end
                end
            end
            local delta = math.abs(#selectedBlocks - before)
            notify((dragAddMode and "Đã thêm chọn " or "Đã bỏ chọn ") .. delta .. " Part.", C.green)
        end
    end
    return Enum.ContextActionResult.Sink
end

