-- Phần màu của Block có thể tên "ColorPart" hoặc "Part"
local COLOR_PART_NAMES = { "ColorPart", "Part" }
local function findColorPart(block)
    if not block then return nil end
    for _, n in ipairs(COLOR_PART_NAMES) do
        local c = block:FindFirstChild(n)
        if c and c:IsA("BasePart") then return c end
    end
    return nil
end

local function getContainer()
    local c, err = resolvePath(CONFIG.BuildContainer)
    if not c then
        return nil, "Không tìm thấy BuildContainer (" .. CONFIG.BuildContainer .. "): " .. tostring(err)
    end
    return c
end

-- Gọi PlaceBlock và xác định chính xác Block vừa tạo.
-- (1) nếu server trả về Instance hợp lệ thì dùng nó;
-- (2) nếu không, theo dõi ChildAdded của container và chỉ nhận khi có ĐÚNG 1 Block mới.
local function placeBlock(blockTemplate, cf)
    local remote, rerr = getRemote("PlaceBlock")
    if not remote then return nil, rerr end

    local container, cerr = getContainer()
    if not container then return nil, cerr end

    local existing = {}
    for _, c in ipairs(container:GetChildren()) do
        existing[c] = true
    end

    local newChildren = {}
    local conn = container.ChildAdded:Connect(function(child)
        if not existing[child] then
            newChildren[#newChildren + 1] = child
        end
    end)

    local ok, ret = pcall(function()
        return remote:InvokeServer(
            blockTemplate,
            cf,
            BrickColor.new(CONFIG.BlockColor),
            CONFIG.BlockMaterial
        )
    end)

    if not ok then
        conn:Disconnect()
        return nil, "PlaceBlock lỗi: " .. tostring(ret)
    end
    if ret == false then
        conn:Disconnect()
        return nil, "Server từ chối PlaceBlock (trả về false)"
    end

    -- Chờ Block mới xuất hiện
    local waited = 0
    while #newChildren == 0 and waited < CONFIG.PlaceWaitTimeout do
        task.wait(0.05)
        waited = waited + 0.05
    end
    task.wait(CONFIG.SettleTime) -- chờ thêm để phát hiện trường hợp nhiều Block cùng xuất hiện
    conn:Disconnect()

    local block
    if typeof(ret) == "Instance" and ret.Parent then
        block = ret -- server trả về Block, đã xác minh còn tồn tại
    elseif #newChildren == 1 then
        block = newChildren[1]
    elseif #newChildren == 0 then
        return nil, "Không phát hiện Block mới trong " .. container:GetFullName()
            .. " (kiểm tra lại CONFIG.BuildContainer)"
    else
        return nil, "Phát hiện " .. #newChildren .. " Block mới cùng lúc, không xác định được Block đúng"
    end

    -- Xác minh ColorPart trước khi dùng
    local colorPart = findColorPart(block)
    local waitedCP = 0
    while not colorPart and waitedCP < CONFIG.ColorPartTimeout do
        task.wait(0.1)
        waitedCP = waitedCP + 0.1
        colorPart = findColorPart(block)
    end
    if not colorPart then
        return nil, "Block '" .. block.Name .. "' không có 'ColorPart'"
    end
    return block, colorPart
end

local function resizeBlock(block, colorPart, cf, size)
    local remote, rerr = getRemote("CommitResize")
    if not remote then return false, rerr end
    if not block.Parent or not colorPart.Parent then
        return false, "Block đã bị xóa trước khi Resize"
    end
    local ok, ret = pcall(function()
        return remote:InvokeServer(block, {
            colorPart,
            cf,
            Vector3.new(size.X, size.Y, size.Z),
        })
    end)
    if not ok then return false, "CommitResize lỗi: " .. tostring(ret) end
    if ret == false then return false, "Server từ chối CommitResize" end
    return true
end

local function moveBlock(block, cf)
    local remote, rerr = getRemote("CommitMove")
    if not remote then return false, rerr end
    if not block.Parent then
        return false, "Block đã bị xóa trước khi Move"
    end
    local ok, ret = pcall(function()
        return remote:InvokeServer(block, cf)
    end)
    if not ok then return false, "CommitMove lỗi: " .. tostring(ret) end
    if ret == false then return false, "Server từ chối CommitMove" end
    return true
end

-- Cơ chế Copy nhiều block (lấy từ MasterTool V49):
-- Block đầu tiên đặt tại đích; các block còn lại đặt tạm trên cao, cách xa nhau.
-- Chỉ sau khi tạo xong tất cả mới Resize/Move chúng về CFrame đích.
local STAGE_GAP = 10
local STAGE_HEIGHT = 60

local function assignStageCFrames(snapshot)
    for _, job in ipairs(snapshot) do
        job.PlaceCF = job.CF
    end
    if #snapshot <= 1 then return end

    local maxDim, maxY = 4.5, -math.huge
    local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge

    for _, job in ipairs(snapshot) do
        local pos = job.CF.Position
        maxDim = math.max(maxDim, job.Resize.X, job.Resize.Y, job.Resize.Z)
        maxY = math.max(maxY, pos.Y + math.max(job.Resize.X, job.Resize.Y, job.Resize.Z))
        minX, maxX = math.min(minX, pos.X), math.max(maxX, pos.X)
        minZ, maxZ = math.min(minZ, pos.Z), math.max(maxZ, pos.Z)
    end

    local container = getContainer()
    if container then
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("PVInstance") then
                local ok, pivot = pcall(function() return child:GetPivot() end)
                if ok and pivot then
                    maxY = math.max(maxY, pivot.Position.Y + 20)
                end
            end
        end
    end

    local spacing = maxDim + STAGE_GAP
    local count = #snapshot - 1
    local cols = math.ceil(math.sqrt(count))
    local rows = math.ceil(count / cols)
    local centerX, centerZ = (minX + maxX) / 2, (minZ + maxZ) / 2
    local stageY = maxY + STAGE_HEIGHT

    for i = 2, #snapshot do
        local index = i - 2
        local row, col = math.floor(index / cols), index % cols
        local pos = Vector3.new(
            centerX + (col - (cols - 1) / 2) * spacing,
            stageY,
            centerZ + (row - (rows - 1) / 2) * spacing
        )
        snapshot[i].PlaceCF = CFrame.new(pos)
    end
end

-- Kiểm tra toàn bộ Array trước khi chạy. Trả về danh sách template đã phân giải.
local function validateAll()
    if #BlockArray == 0 then
        return nil, "Array trống"
    end
    local templates = {}
    for i, it in ipairs(BlockArray) do
        local inst, err = resolvePath(it.PathBlock)
        if not inst then
            return nil, string.format("Vị trí %d: %s", i, err)
        end
        if typeof(it.CF) ~= "CFrame" then
            return nil, string.format("Vị trí %d: Vector không hợp lệ", i)
        end
        if typeof(it.Resize) ~= "Vector3" or it.Resize.X <= 0 or it.Resize.Y <= 0 or it.Resize.Z <= 0 then
            return nil, string.format("Vị trí %d: Resize không hợp lệ", i)
        end
        templates[i] = inst
    end
    return templates
end

local function setLocked(locked)
    isRunning = locked
    for _, box in ipairs({ pathBox, vectorBox, resizeBox }) do
        box.TextEditable = not locked
    end
    execBtn.Text = locked and "Đang chạy..." or "Execute"
    execBtn.BackgroundTransparency = locked and 0.5 or 0
