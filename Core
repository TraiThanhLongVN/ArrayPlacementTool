local function trim(s)
    return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Phân giải chuỗi "Service.Folder.Item" thành Instance thật.
local function resolvePath(path)
    if type(path) ~= "string" or trim(path) == "" then
        return nil, "Đường dẫn trống"
    end

    local parts = {}
    for p in path:gmatch("[^%.]+") do
        parts[#parts + 1] = trim(p)
    end
    if #parts == 0 then
        return nil, "Đường dẫn không hợp lệ"
    end

    local current
    local first = parts[1]
    if first:lower() == "game" then
        current = game
    elseif first:lower() == "workspace" then
        current = workspace
    else
        local ok, svc = pcall(function()
            return game:GetService(first)
        end)
        if ok and svc then
            current = svc
        else
            current = game:FindFirstChild(first)
        end
    end

    if not current then
        return nil, "Không xác định được gốc đường dẫn '" .. first .. "' (hãy bắt đầu bằng tên Service)"
    end

    for i = 2, #parts do
        local nextObj = current:FindFirstChild(parts[i])
        if not nextObj then
            return nil, "Không tìm thấy '" .. parts[i] .. "' trong " .. current:GetFullName()
        end
        current = nextObj
    end

    if current == game then
        return nil, "Đường dẫn chỉ trỏ tới 'game', không phải Block"
    end
    return current
end

-- Lấy danh sách số từ chuỗi: "1, 2, 3" / "Vector3.new(1,2,3)" / "CFrame.new(...)"
local function parseNumbers(text)
    if type(text) ~= "string" then
        return nil, "Giá trị không phải chuỗi"
    end
    local inner = text:match("%((.*)%)") or text
    local nums = {}
    for token in inner:gmatch("[^,%s;]+") do
        local n = tonumber(token)
        if n == nil then
            return nil, "'" .. token .. "' không phải số"
        end
        if n ~= n or n == math.huge or n == -math.huge then
            return nil, "Số không hợp lệ"
        end
        nums[#nums + 1] = n
    end
    return nums
end

-- 3 số (x,y,z) hoặc 12 số (x,y,z + 9 số xoay) -> CFrame
local function parseCFrame(text)
    local nums, err = parseNumbers(text)
    if not nums then return nil, err end
    if #nums == 3 then
        return CFrame.new(nums[1], nums[2], nums[3])
    end
    if #nums == 12 then
        local allZero = true
        for i = 4, 12 do
            if nums[i] ~= 0 then
                allZero = false
                break
            end
        end
        if allZero then
            return CFrame.new(nums[1], nums[2], nums[3])
        end
        return CFrame.new(table.unpack(nums))
    end
    return nil, "Cần 3 số (x,y,z) hoặc 12 số (x,y,z + 9 số xoay)"
end

local function parseSize(text)
    local nums, err = parseNumbers(text)
    if not nums then return nil, err end
    if #nums ~= 3 then
        return nil, "Cần đúng 3 số (x, y, z)"
    end
    if nums[1] <= 0 or nums[2] <= 0 or nums[3] <= 0 then
        return nil, "Kích thước phải > 0"
    end
    return Vector3.new(nums[1], nums[2], nums[3])
end

local function fmtNum(n)
    if math.abs(n) < 1e-9 then return "0" end
    return string.format("%.8g", n)
end

local function cfStrings(cf)
    local t = {}
    for i, n in ipairs({ cf:GetComponents() }) do
        t[i] = fmtNum(n)
    end
    return t
end

local function isIdentityRot(cf)
    local c = { cf:GetComponents() }
    local id = { 1, 0, 0, 0, 1, 0, 0, 0, 1 }
    for i = 1, 9 do
        if math.abs(c[i + 3] - id[i]) > 1e-6 then
            return false
        end
    end
    return true
end

-- Chuỗi đầy đủ 12 số (hiển thị trong danh sách)
local function textCFFull(cf)
    return table.concat(cfStrings(cf), ", ")
end

-- Chuỗi gọn cho Textbox: chỉ 3 số nếu không xoay
local function textCFShort(cf)
    if isIdentityRot(cf) then
        local t = cfStrings(cf)
        return t[1] .. ", " .. t[2] .. ", " .. t[3]
    end
    return textCFFull(cf)
end

local function textVec(v)
    return fmtNum(v.X) .. ", " .. fmtNum(v.Y) .. ", " .. fmtNum(v.Z)
end

-- Lấy RemoteFunction và kiểm tra đúng loại
local function getRemote(name)
    local folder = ReplicatedStorage:FindFirstChild("Functions")
    if not folder then
        return nil, "Không thấy ReplicatedStorage.Functions"
    end
    local r = folder:FindFirstChild(name)
    if not r then
        return nil, "Không thấy RemoteFunction '" .. name .. "'"
    end
    if not r:IsA("RemoteFunction") then
        return nil, "'" .. name .. "' không phải RemoteFunction"
    end
    return r
end

