local function addBlockSelection(block)
    -- Phòng vệ ở đầu hàm: không cho Model hoặc instance khác lọt vào selection.
    if not block or not block:IsA("BasePart") or not block.Parent then return end
    if not isBlockSelected(block) then
        selectedBlocks[#selectedBlocks + 1] = block
        if block:IsA("BasePart") then
            local h = Instance.new("Highlight")
            h.Name = "ArraySelectedBlockHighlight"
            h.Adornee = block
            h.FillColor = Color3.fromRGB(255, 220, 0)
            h.OutlineColor = Color3.fromRGB(255, 245, 130)
            h.FillTransparency = 0.55
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Enabled = highlightsVisible
            h.Parent = workspace
            blockHighlights[block] = h
        end
    end
    selBlock = block
    refreshMultiCount()
    updateHighlightVisibility()
    refreshInfo()
    buildView()
end

local function removeBlockSelection(block)
    for i = #selectedBlocks, 1, -1 do
        if selectedBlocks[i] == block then
            table.remove(selectedBlocks, i)
            break
        end
    end
    local highlight = blockHighlights[block]
    if highlight then highlight:Destroy() end
    blockHighlights[block] = nil
    if selBlock == block then
        selBlock = selectedBlocks[#selectedBlocks]
    end
    refreshMultiCount()
    refreshInfo()
    buildView()
end

local function clearBlockSelections()
    table.clear(selectedBlocks)
    for block, highlight in pairs(blockHighlights) do
        if highlight then highlight:Destroy() end
        blockHighlights[block] = nil
    end
    selBlock = nil
    refreshMultiCount()
    refreshInfo()
    buildView()
end

