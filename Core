local function refreshMultiCount()
    local count = 0
    for i = #selectedBlocks, 1, -1 do
        local part = selectedBlocks[i]
        if not part or not part:IsA("BasePart") or not part.Parent then
            table.remove(selectedBlocks, i)
        else
            count += 1
        end
