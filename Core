local delayBox = setBox(5, tostring(CONFIG.StepDelay))
delayBox.FocusLost:Connect(function()
    local n = tonumber(delayBox.Text)
    if n and n >= 0 and n <= 5 then
        CONFIG.StepDelay = n
        persistConfig()
        notify("Đã đổi StepDelay: " .. n, C.green)
    else
        delayBox.Text = tostring(CONFIG.StepDelay)
        notify("Giá trị phải từ 0 đến 5.", C.red)
    end
end)

setLabel(6, "Số Block đặt cùng lúc (1 - 20)")
local batchBox = setBox(7, tostring(CONFIG.BatchSize))
batchBox.FocusLost:Connect(function()
    local n = math.floor(tonumber(batchBox.Text) or 0)
    if n >= 1 and n <= 20 then
        CONFIG.BatchSize = n
        persistConfig()
        notify("Đã đặt " .. n .. " Block cùng lúc.", C.green)
    else
        batchBox.Text = tostring(CONFIG.BatchSize)
        notify("Giá trị phải từ 1 đến 20.", C.red)
    end
end)

----------------------------------------------------------------
-- KHỞI ĐỘNG
----------------------------------------------------------------
-- Nếu Auto Load Config bật, nạp ArrayText đã lưu khi script khởi động.
if autoLoadConfig and startupConfig and type(startupConfig.ArrayText) == "string" and startupConfig.ArrayText ~= "" then
    local loadedItems, loadErr = parseArrayText(startupConfig.ArrayText)
    if loadedItems then
        BlockArray = loadedItems
        selected = BlockArray[1]
    else
        warn("[ArrayPlacementTool] Auto Load Config lỗi: " .. tostring(loadErr))
    end
end
loadBoxes()
refreshAll()
setEditorText(buildText())
if startupConfig and type(startupConfig.ShowSearch) == "boolean" then
    showSearch = startupConfig.ShowSearch
    applySearchVisibility()
    refreshSearchToggle()
end
persistConfig()
if startupLoadingGui then pcall(function() startupLoadingGui:Destroy() end) end
notify("Sẵn sàng. Nhập dữ liệu rồi bấm Execute.")
