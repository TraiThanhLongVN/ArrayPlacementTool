local function updateCam()
    if not vpClone then return end
    local pos = vpCenter + Vector3.new(math.sin(spinAngle) * vpDist, vpDist * 0.35, math.cos(spinAngle) * vpDist)
    cam.CFrame = CFrame.lookAt(pos, vpCenter)
end

local function clearView()
    if vpClone then
        vpClone:Destroy()
        vpClone = nil
    end
    viewport.Visible = false
    viewHint.Visible = true
end

local function buildView()
    clearView()
    if not selBlock or not showView then return end

    local function tryClone()
        local ok, c = pcall(function() return selBlock:Clone() end)
        if ok then return c end
        return nil
    end
    local clone = tryClone()
    if not clone then
        -- Block không cho Clone: bật Archivable cục bộ rồi thử lại
        pcall(function()
            selBlock.Archivable = true
            for _, d in ipairs(selBlock:GetDescendants()) do
                d.Archivable = true
            end
        end)
        clone = tryClone()
    end
    if not clone then return end

    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("LuaSourceContainer") then d:Destroy() end
    end

    local wrap = Instance.new("Model")
    clone.Parent = wrap
    wrap.Parent = viewport
    local ok, cf, size = pcall(function() return wrap:GetBoundingBox() end)
    if not ok or not cf then
        wrap:Destroy()
        return
    end

    vpClone = wrap
    vpCenter = cf.Position
    vpDist = size.Magnitude * 0.95 + 0.5
    viewHint.Visible = false
    viewport.Visible = true
    updateCam()
end

local function isBlockSelected(block)
    for _, item in ipairs(selectedBlocks) do
